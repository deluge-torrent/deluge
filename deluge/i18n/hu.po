#: deluge/argparserbase.py:169
msgid "Common Options"
msgstr "Általános beállítások"

#: deluge/argparserbase.py:172
msgid "Print this help message"
msgstr "Súgó szövegének megjelenítése"

#: deluge/argparserbase.py:179
msgid "Print version information"
msgstr "Verziószám kiírása"

#: deluge/argparserbase.py:191
msgid "Set the config directory path"
msgstr "Konfigurációs könyvtár elérési útvonalának megadása"

#: deluge/argparserbase.py:197
msgid "Output to specified logfile instead of stdout"
msgstr "Kimenet a megadott naplófájlba a szabványos kimenet helyett"

#: deluge/argparserbase.py:203
msgid "Set the log level (none, error, warning, info, debug)"
msgstr "Naplózási szint megadása (semmi, hiba, figyelmeztetés, infó, hibakeresés)"

#: deluge/argparserbase.py:212
#, python-format
msgid "Enable logfile rotation, with optional maximum logfile size, default: %(const)s (Logfile rotation count is 5)"
msgstr ""
"Naplófájl forgatásának engedélyezése, maximális naplófájlmérettel (nem kötelező), alapértelmezett: %(const)s "
"(Naplófájlforgatások száma: 5)"

#: deluge/argparserbase.py:220
msgid "Quieten logging output (Same as `--loglevel none`)"
msgstr "Naplózási kimenet tompítása (ugyanaz, mint a `--loglevel none`)"

#: deluge/argparserbase.py:228
#, python-format
msgid "Profile %(prog)s with cProfile. Outputs to stdout unless a filename is specified"
msgstr ""
"%(prog)s profilozása a cProfile használatával. Kimenet a szabványos kimenetre, kivéve ha egy fájlnév meg van adva"

#: deluge/argparserbase.py:348
msgid "Process Control Options"
msgstr "Folyamatvezérlési beállítások"

#: deluge/argparserbase.py:354
msgid "Pidfile to store the process id"
msgstr "PID-fájl a folyamatazonosító tárolásához"

#: deluge/argparserbase.py:362
msgid "Do not daemonize (fork) this process"
msgstr "Ne ágaztassa el ezt a folyamatot"

#: deluge/argparserbase.py:376
msgid "Change to this user on startup (Requires root)"
msgstr "Váltás erre a felhasználóra indításkor (rendszergazdai jogosultság szükséges)"

#: deluge/argparserbase.py:383
msgid "Change to this group on startup (Requires root)"
msgstr "Váltás erre a csoportra indításkor (rendszergazdai jogosultság szükséges)"

